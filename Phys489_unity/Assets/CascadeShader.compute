#pragma kernel CSMain

// Cloud visualization shader.
// The UM cascade field is pre-computed by FIFGenerator and supplied as FIFFieldTex.
// This shader composites the cloud layer over the terrain albedo and applies
// the IR colour gradient, writing the final result to the display RenderTexture.

// --- OUTPUTS ---
RWTexture2D<float4> Result;      // Cloud composite RenderTexture (assigned to PlanetMat)

// --- TEXTURES ---
Texture2D<float>  FIFFieldTex;  // Pre-computed dressed cloud field: exp(log_field)
Texture2D<float4> GradientTex;  // IR colour gradient LUT (256x1)
Texture2D<float4> AlbedoTex;    // Terrain colour RenderTexture from TerrainShader
SamplerState      _LinearClamp;

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    Result.GetDimensions(width, height);

    float2 uv = float2((float)id.x / width, (float)id.y / height);

    // --- CLOUD FIELD ---
    // FIFFieldTex already contains exp(log_field) — the dressed multifractal flux.
    float fieldIntensity = FIFFieldTex.SampleLevel(_LinearClamp, uv, 0);

    // --- VISUALIZATION ---
    // Log tone-map compresses the multifractal dynamic range into [0,1] for display.
    float tonemapScale = 3.0;
    float displayValue = saturate(log(1.0 + fieldIntensity) / log(1.0 + tonemapScale));

    float4 earthColor = AlbedoTex.SampleLevel(_LinearClamp, uv, 0);
    float4 cloudColor = GradientTex.SampleLevel(_LinearClamp, float2(displayValue, 0.5), 0);
    float  alpha      = saturate(displayValue * 1.5);
    Result[id.xy]     = lerp(earthColor, cloudColor, alpha);
}
